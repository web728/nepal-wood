# ---------- Site ----------
# Public URL of the live site (used for canonical URLs, sitemap, QR badges, emails)
NEXT_PUBLIC_SITE_URL=https://nepalwood.com.np

# ---------- MongoDB ----------
# MongoDB Atlas connection string (free M0 cluster is enough), or a local server.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=nepalwood

# ---------- Admin panel (/admin) ----------
# Password the team uses to log in, and a long random secret used to sign the session cookie.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters

# ---------- Google Sheets ----------
# Web app URL from the Apps Script deployment (see integrations/google-sheets/SETUP.md)
SHEETS_WEBHOOK_URL=
# Must match SHARED_SECRET inside the Apps Script
SHEETS_WEBHOOK_SECRET=

# ---------- Email (optional) ----------
# If set, visitors get their badge by email and the sales team gets an alert for every stand enquiry.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nepal Wood Expo <no-reply@nepalwood.com.np>"
# Comma-separated inboxes that receive new-lead alerts
LEADS_NOTIFY_TO=namit@futurextrade.com,info@mss.com.np

# ---------- Analytics (optional) ----------
# Google Analytics 4 measurement ID. Loads only after the visitor accepts cookies.
NEXT_PUBLIC_GA_ID=
